{
  "info": {
    "name": "BuildPro HQ API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Professional Postman collection for BuildPro HQ backend APIs (v1). Includes authentication, users, projects, sites, tasks, notifications, lookups, sync and audit endpoints. Use the accompanying environment variables."
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@buildpro.com\",\n  \"password\": \"Manager@123\",\n  \"portalRole\": \"manager\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.environment.set('jwt_token', json.data && json.data.accessToken ? json.data.accessToken : '');",
                  "  pm.environment.set('me_role', json.data && json.data.user ? json.data.user.role : '');",
                  "  pm.environment.set('me_user_id', json.data && json.data.user ? json.data.user.id : '');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (Super Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"super@buildpro.com\",\n  \"password\": \"Super@123\",\n  \"portalRole\": \"super_admin\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login (super) succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var json = pm.response.json();",
                  "  pm.environment.set('jwt_token', json.data && json.data.accessToken ? json.data.accessToken : '');",
                  "  pm.environment.set('me_role', json.data && json.data.user ? json.data.user.role : '');",
                  "  pm.environment.set('me_user_id', json.data && json.data.user ? json.data.user.id : '');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          },
          "response": []
        }
      ]
    },
