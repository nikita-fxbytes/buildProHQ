# ==============================================================================
# BuildPro HQ - Professional Backend Environment Configuration
# ==============================================================================

# --- APPLICATION ---
APP_NAME="BuildPro HQ API"
NODE_ENV=development
PORT=3001

#
# --- DATABASE (PostgreSQL) ---
# Preferred: single connection URL (used by TypeORM if present)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://postgres:replace_me@127.0.0.1:5432/buildprohq?schema=public

DB_LOGGING=true

# --- SECURITY ---
# Generate a secure secret using: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# --- RATE LIMITING ---
THROTTLER_TTL=60000
THROTTLER_LIMIT=120

# --- DOCUMENTATION ---
SWAGGER_PATH=api/docs

# --- STORAGE & UPLOADS ---
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# --- LOGGING ---
LOG_LEVEL=info # debug, info, warn, error

#
# (Removed duplicate MySQL block; backend is PostgreSQL.)

# --- INVITES / PASSWORD SET ---
# Frontend base URL used to build set-password link.
FRONTEND_BASE_URL=http://localhost:3000
# Secret used to hash invite tokens (keep private)
INVITE_TOKEN_SECRET=replace_with_a_long_random_secret
# Invite link expiry in hours
INVITE_EXPIRES_HOURS=48

# --- EMAIL (SMTP) ---
# If SMTP_* are blank, the API will log the invite link instead of sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
